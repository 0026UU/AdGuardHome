.menu {
    padding-top: 8px;
    display: none;
    box-shadow: var(--main-box-shadow);
    min-height: 100vh;
    max-width: 240px;
    flex-shrink: 0;
    z-index: 1;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
    }
}

.menuWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100vh - 80px);
    padding-bottom: env(safe-area-inset-bottom);

    @media (min-width: 1200px) {
        min-height: 0;
        flex: 1;
    }

    &.headerMenu {
        min-height: 100%;
        justify-content: flex-start;
        gap: 80px;
    }
}

.menuLink,
.accordionLink {
    display: flex;
    align-items: center;
    gap: 12px;
    /* the row is inset from the rail so the rounded fill reads as a pill,
       while the label keeps its original 16px offset from the edge */
    margin: 0 8px;
    padding: 12px 8px;
    border-radius: var(--radius-sm);
    font-size: 16px;
    line-height: 21px;
    font-weight: var(--weight-regular);
    color: var(--default-main-text);
    text-decoration: none;
    max-width: 100%;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    vertical-align: middle;
    transition:
        background-color var(--t2),
        color var(--t2);
    outline: none;

    &:hover,
    &:focus {
        color: var(--default-main-text);
        background-color: var(--default-item-hovered-background);
        text-decoration: none;
    }

    &:active {
        background-color: var(--default-item-pressed-background);
    }

    &.activeLink {
        color: var(--default-selected-item-text);
        background-color: var(--default-selected-item-background);
        font-weight: var(--weight-medium);

        .linkIcon {
            color: var(--default-selected-item-text);
        }
    }
}

.accordionLink {
    padding: 12px 8px 12px 44px;
}

.linkIcon {
    color: var(--default-gray-icons);
    transition: color var(--t2);
}

.withConfirmIcon {
    display: flex;
    align-items: center;
}

.topMenuWrapper {
    margin-bottom: auto;

    @media (min-width: 1200px) {
        margin-bottom: 0;
    }
}

.referenceWrapper {
    margin-top: auto;
}

/* Group heading. Apple keeps a section title smaller, heavier and quieter than
   the rows under it; no text-transform here because uppercasing is wrong for
   several of the locales this console ships in. */
.accordionHeader {
    cursor: pointer;
    user-select: none;
    font-size: var(--fs-text-t3);
    font-weight: var(--weight-semi-bold);
    color: var(--default-labels);

    /* a hovered group keeps its quiet label colour */
    &:hover,
    &:focus {
        color: var(--default-labels);
    }

    /* only the selected row inside a group gets the tinted fill; the heading
       just tints its label and icon, otherwise a section and its row would
       both light up */
    &.activeLink {
        background-color: transparent;
        color: var(--default-selected-item-text);
        font-weight: var(--weight-semi-bold);

        .linkIcon {
            color: var(--default-selected-item-text);
        }
    }
}

.accordionArrow {
    margin-left: auto;
    color: var(--default-gray-icons);
    transition:
        transform var(--t2),
        color var(--t2);
}

.accordionArrowOpen {
    transform: rotate(180deg);
}
