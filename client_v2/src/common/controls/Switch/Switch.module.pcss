.switch {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    gap: 8px;

    &.disabled {
        cursor: default;
    }
}

.input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

.label {
    font-size: 16px;
    font-weight: var(--weight-medium);
    user-select: none;
}

.handler {
    position: relative;
    width: 51px;
    height: 31px;
    border-radius: var(--radius-pill);
    background-color: var(--fills-switch-off-default);
    transition: background-color var(--t2);

    @media (hover: hover) {
        &:hover {
            background-color: var(--fills-switch-off-hovered);
        }
    }

    &:before {
        content: '';
        position: absolute;
        top: 2px;
        left: 2px;
        width: 27px;
        height: 27px;
        border-radius: var(--radius-pill);
        background-color: var(--fills-switch-knob);
        transition:
            transform var(--t2),
            background-color var(--t2);
    }
}

.input:focus-visible + .handler {
    background-color: var(--fills-switch-off-hovered);
}

.input:checked + .handler {
    background-color: var(--fills-switch-on-default);

    @media (hover: hover) {
        &:hover {
            background-color: var(--fills-switch-on-hovered);
        }
    }

    &:before {
        /* 51 track - 27 knob - 2 * 2 inset = the same 20px travel as before */
        transform: translateX(20px);
    }
}

.input:focus-visible:checked + .handler {
    background-color: var(--fills-switch-on-hovered);
}

.input:disabled + .handler {
    cursor: default;
    background-color: var(--fills-switch-off-disabled);

    @media (hover: hover) {
        &:hover {
            background-color: var(--fills-switch-off-disabled);
        }
    }

    &:before {
        color: var(--fills-switch-knob-disabled);
    }
}

.input:checked:disabled + .handler {
    background-color: var(--fills-switch-on-disabled);

    @media (hover: hover) {
        &:hover {
            background-color: var(--fills-switch-on-disabled);
        }
    }

    &:before {
        color: var(--fills-switch-knob-disabled);
    }
}
