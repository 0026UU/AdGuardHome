.tooltip {
    border-radius: var(--radius-sm);
    padding: 8px 0 12px;
    min-width: 280px;
    box-shadow:
        0 8px 18px -6px var(--dropdown-box-shadow),
        0 12px 42px -4px var(--dropdown-box-shadow);
    cursor: default;
}

.tooltipTitle {
    padding: 8px 16px;
}

.tooltipRow {
    min-height: 24px;
    padding: 4px 16px;
    font-weight: var(--weight-semi-bold);
}

.tooltipValue {
    font-weight: var(--weight-regular);
}

.tooltipStatusValue {
    color: var(--default-error-link);
}
